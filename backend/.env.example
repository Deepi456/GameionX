# Select "development-mock" for offline development, "gemini" for Gemini,
# or "groq" for Groq's OpenAI-compatible API.
GAMEIONX_PROVIDER=development-mock
# SQLite is persistent across backend restarts; defaults to backend/gameionx.sqlite3.
GAMEIONX_DATABASE_PATH=
# Set GAMEIONX_ENV=production and provide a random secret of at least 32 bytes before deployment.
GAMEIONX_ENV=development
GAMEIONX_SESSION_SECRET=
# Enable secure cookies behind HTTPS; production defaults to secure cookies.
GAMEIONX_COOKIE_SECURE=
# Optional comma-separated browser origins for a deployed frontend.
GAMEIONX_ALLOWED_ORIGINS=
GEMINI_API_KEY=
# Use a lightweight Gemini default to reduce cost and quota usage.
GEMINI_MODEL=gemini-2.0-flash-lite
# Optional fallback model used after the primary Gemini model hits transient quota or availability errors.
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite
GROQ_API_KEY=
# Groq uses the OpenAI-compatible chat completions endpoint.
GROQ_MODEL=llama-3.3-70b-versatile
# Maximum wall-clock time for a browser playtest before remaining checks are untested.
PLAYTEST_BUDGET_SECONDS=40
